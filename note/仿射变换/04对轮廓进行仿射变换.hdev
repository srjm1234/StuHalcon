<?xml version="1.0" encoding="UTF-8"?>
<hdevelop file_version="1.1" halcon_version="17.12">
<procedure name="main">
<interface/>
<body>
<c>*图片 , 区域 , 轮廓 </c>
<c>*对轮廓的仿射变换  </c>
<l>read_image (Image, 'printer_chip/printer_chip_01')</l>
<c>*二值化处理</c>
<l>threshold (Image, Region, 128, 255)</l>
<c>*分割</c>
<l>connection (Region, ConnectedRegions)</l>
<c>*特征过滤 </c>
<l>select_shape (ConnectedRegions, SelectedRegions, 'area', 'and', 27745.5, 30491)</l>
<l>dev_clear_window ()</l>
<l>dev_display (Image)</l>
<l>dev_display (SelectedRegions)</l>
<l>stop ()</l>
<c></c>
<c>*拿出一块区域 </c>
<l>select_obj (SelectedRegions, ObjectSelected, 1)</l>
<l>dev_clear_window ()</l>
<l>dev_display (Image)</l>
<l>dev_display (ObjectSelected)</l>
<l>stop ()</l>
<c>*把区域转换成 轮廓 </c>
<l>gen_contour_region_xld (ObjectSelected, NewXLD, 'border')</l>
<l>dev_clear_window ()</l>
<l>dev_set_line_width (3)</l>
<l>dev_display (Image)</l>
<l>dev_display (NewXLD)</l>
<l>stop ()</l>
<c>*对轮廓进行仿射变换 </c>
<c>*获取轮廓的 中心坐标</c>
<l>area_center_xld (NewXLD, Area, Row, Column, PointOrder)</l>
<c>*获取轮廓的角度</c>
<l>orientation_xld (NewXLD, Phi)</l>
<c>*获取图像的大小 </c>
<l>get_image_size (Image, Width, Height)</l>
<c>*刚性矩阵  </c>
<l>vector_angle_to_rigid (Row, Column, Phi,  Height/2, Width/2, Phi, HomMat2D)</l>
<c>*仿射变换</c>
<l>affine_trans_contour_xld (NewXLD, ContoursAffineTrans, HomMat2D)</l>
<l>dev_clear_window ()</l>
<l>dev_set_line_width (3)</l>
<l>dev_display (Image)</l>
<l>dev_display (ContoursAffineTrans)</l>
<l>stop ()</l>
<c></c>
</body>
<docu id="main">
<parameters/>
</docu>
</procedure>
</hdevelop>
